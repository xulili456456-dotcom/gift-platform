{
  "apps": [
    {
      "name": "gift-platform",
      "script": "src/app.js",
      "cwd": "./server",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3001,
        "JWT_SECRET": "change-this-to-a-random-secret-string",
        "JWT_REFRESH_SECRET": "change-this-to-another-random-secret",
        "CORS_ORIGIN": "http://localhost:3001"
      },
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "200M"
    }
  ]
}
